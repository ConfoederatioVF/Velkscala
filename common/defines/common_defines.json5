  config_dirs: {
    tabulation: "common/tabulation",
    testing: "common/testing",
    visualisation: "common/visualisation"
  },

  stages: {
    generate_data: {
      id: "generate_data",
      category: "tabulation",
      label: "Generate Data",
      description: "Compiles and bins demographic validation data into .json and .md files in outputs/ from common/tabulation/.",
      pipeline_ids: ["tab_cdt", "tab_ndt"]
    },
    run_tests: {
      id: "run_tests",
      category: "testing",
      label: "Run Tests",
      description: "Executes Contemporary (CDT) and Neolithic (NDT) validation and model verification suites from common/testing/.",
      pipeline_ids: ["test_cdt", "test_ndt", "test_piecewise_ndt"]
    },
    generate_figures: {
      id: "generate_figures",
      category: "visualisation",
      label: "Generate Figures",
      description: "Renders numbered R ggplot2 validation figures from compiled .json datasets via common/visualisation/.",
      pipeline_ids: ["render_cdt_r", "render_ndt_r"]
    }
  },

  paths: {
    h1: "D:/Project 1509 - SVEA/histmap/1.data_raw/",
    h2: "D:/Project 1509 - SVEA/histmap/2.data_cleaning/",
    h3: "D:/Project 1509 - SVEA/histmap/3.data_transform/",
    h4: "D:/Project 1509 - SVEA/histmap/4.data_exports/",
    h5: "D:/Project 1509 - SVEA/histmap/5.data_visualisation/",
    svea_node_modules: "D:/Project 1509 - SVEA/node_modules",
    svea_uf: "D:/Project 1509 - SVEA/UF",
    test_cdt_dir: "data/3.data_transform/test_cdt",
    test_ndt_dir: "data/3.data_transform/test_ndt"
  }
}
