{
  // =========================================================================
  // NDT Testing & Verification Configuration (common/testing/)
  // =========================================================================
  category: "testing",
  suite: "ndt",
  title: "NDT Validation Suites",

  pipelines: {
    test_ndt: {
      id: "test_ndt",
      name: "NDT Empirical Validation Suite",
      category: "testing",
      stage: "run_tests",
      description: "Evaluates Neolithic Demographic Transition (10000 BC–1000 AD) across 5 macro-regions and 19 geocodes against Bocquet-Appel priors.",
      command: "node",
      args: ["$TEST_NDT_DIR/test_ndt_validation.js"],
      outputs: [
        "$OUTPUTS_DIR/ndt_validation_results.json",
        "$OUTPUTS_DIR/ndt.md"
      ],
      tab_index: 1
    },
    test_piecewise_ndt: {
      id: "test_piecewise_ndt",
      name: "NDT Piecewise Model Verification",
      category: "testing",
      stage: "run_tests",
      description: "Verifies premodern 34-covariate multinomial logit architecture, unified coverage ensemble, and agricultural logit differential.",
      command: "node",
      args: ["$TEST_NDT_DIR/test_piecewise_ndt_verification.js"],
      outputs: [],
      tab_index: 1
    }
  }
}

