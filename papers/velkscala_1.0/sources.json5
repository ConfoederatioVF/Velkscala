/*
  Bibliography Sources (sources.json5 -> compiled automatically into velkscala.bib)
  Prefer citing works by `doi`; bibliographic metadata is resolved via DOI content negotiation and cached locally.
  Where no DOI exists, provide `url` (with optional overrides when web `<meta>` tags are incomplete).

  Semantic Structure:
  [
    {
      id: "<citation_key>", //Optional. Referenced as [@<citation_key>] in .Rmd; auto-derived (<surname><year>) when omitted.
      doi: "10.xxxx/...", //Preferred. Resolves author, title, container, volume, issue, pages and year automatically.
      url: "https://...", //Fallback when no DOI exists; scrapes HTML citation <meta> tags when title is omitted.
      type: "article", //Optional override ("article", "book", "incollection", "inproceedings", "misc", "techreport").
      author: "Surname, Given and ...", //Optional override; accepts a BibTeX string or an array of strings.
      corporate_author: false, //Optional. Wraps institutional authors in double braces {{...}} in BibTeX.
      title: "<Title>", //Optional override.
      journal: "<Journal>", //Optional override (or booktitle, editor, institution, publisher, volume, number, pages, year, note).
      year: 2026 //Optional override.
    }
  ]
*/
